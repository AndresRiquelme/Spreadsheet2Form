{
  "manifest_version": 3,

  "name": "Spreadsheet2Form",

  "version": "1.0.0",

  "description": "Transfer grades from spreadsheets to Firefox forms safely.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "clipboardRead",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
