{
  "manifest_version": 3,

  "name": "Spreadsheet2Form",

  "version": "1.0.0",

  "description": "Safely transfer spreadsheet grade data into web-based grading forms."

  "permissions": [
    "activeTab",
    "clipboardRead",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html"
  },

"content_scripts": [
  {
    "matches": [
       "<all_urls>"
    ],
    "js": [
    	"content.js"
    ]
  }
]
}
